---
import site from '../data/site.json';

interface Props {
  current?: 'work' | 'reel' | 'about';
}
const { current } = Astro.props;
---
<header class="nav">
  <a href="/" class="wordmark">{site.name}</a>
  <nav aria-label="Main" class="links">
    <a href="/work" aria-current={current === 'work' ? 'page' : undefined}>Work</a>
    <a href="/work/reel" aria-current={current === 'reel' ? 'page' : undefined}>Reel</a>
    <a href="/about" aria-current={current === 'about' ? 'page' : undefined}>About</a>
  </nav>
  <a href={`mailto:${site.email}`} class="contact">Contact</a>
  <a href="/work" class="pill pill--solid cta">Enter Workspace</a>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 48px;
    min-height: 96px;
    padding: 0 var(--gutter);
    position: relative;
    z-index: 2;
  }
  .wordmark { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; }
  .links { display: flex; gap: 36px; flex-grow: 1; font-size: 17px; }
  .links a[aria-current='page'] { text-decoration: underline; text-underline-offset: 8px; }
  .contact { font-size: 17px; }

  @media (max-width: 860px) {
    .nav { gap: 20px; min-height: 72px; flex-wrap: wrap; padding-top: 12px; padding-bottom: 12px; }
    .wordmark { font-size: 20px; flex-grow: 1; }
    .links { order: 3; width: 100%; gap: 24px; font-size: 16px; }
    .contact { display: none; }
    .cta { min-height: 44px; padding: 0 20px; font-size: 15px; }
  }
</style>
