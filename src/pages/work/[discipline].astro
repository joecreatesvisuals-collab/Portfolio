---
import Base from '../../layouts/Base.astro';
import Shell from '../../components/WorkspaceShell.astro';
import Thumb from '../../components/Thumb.astro';
import data from '../../data/projects.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  return data.disciplines.map((d) => ({ params: { discipline: d.slug }, props: { d } }));
}

const { d } = Astro.props;
const isReel = d.slug === 'reel';
const projects = data.projects.filter((p) => p.disciplines.includes(d.slug));
---
<Base title={d.title} description={d.intro || undefined}>
  <Shell current={isReel ? 'reel' : 'work'}>
    <div class="head" style={`--base:${d.base};--a:${d.glowA};--b:${d.glowB}`}>
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/work">All Work</a><span aria-hidden="true">/</span><span aria-current="page">{d.title}</span>
      </nav>
      <h1>{d.title}</h1>
      {d.intro && <p>{d.intro}</p>}
    </div>

    {isReel ? (
      <main class="reel">
        {site.reel.embed ? (
          <iframe
            src={site.reel.embed}
            title="Demo reel"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        ) : (
          <div class="reel-empty mono">[REEL EMBED GOES HERE: set reel.embed in src/data/site.json]</div>
        )}
      </main>
    ) : (
      <main class="grid">
        {projects.map((p, i) => (
          <button class="card" type="button" data-loop-host data-open={`p-${i}`}>
            <Thumb still={p.still} loop={p.loop} index={i} label={p.title}>
              {p.tc && <span class="tc mono">{p.tc}</span>}
            </Thumb>
            <span class="meta">
              <span class="title">{p.title}</span>
              <span class="sub">{[p.client, p.role, p.year].filter(Boolean).join(' · ')}</span>
            </span>
          </button>
        ))}
        {projects.length === 0 && <p class="empty">Projects coming soon.</p>}
      </main>
    )}

    {!isReel && projects.map((p, i) => (
      <dialog id={`p-${i}`} class="viewer" aria-label={p.title}>
        <div class="viewer-inner">
          <button class="close" type="button" aria-label="Close" data-close>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
          {p.embed ? (
            <div class="frame">
              <iframe data-src={p.embed} title={p.title} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
            </div>
          ) : (
            <Thumb still={p.still} index={i} label={p.title} />
          )}
          <div class="viewer-meta">
            <h2>{p.title}</h2>
            <p>{[p.client, p.role, p.year].filter(Boolean).join(' · ')}</p>
            <p class="mono file">{p.file}</p>
          </div>
        </div>
      </dialog>
    ))}
  </Shell>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dlg = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
      if (!dlg) return;
      const frame = dlg.querySelector<HTMLIFrameElement>('iframe[data-src]');
      if (frame && !frame.src) frame.src = frame.dataset.src!;
      dlg.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.viewer').forEach((dlg) => {
    const close = () => {
      dlg.close();
    };
    dlg.querySelector('[data-close]')?.addEventListener('click', close);
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.addEventListener('close', () => {
      // Stop playback when the viewer closes.
      const frame = dlg.querySelector<HTMLIFrameElement>('iframe');
      if (frame && frame.src) frame.src = frame.src;
    });
  });
</script>

<style>
  .head {
    position: relative;
    padding: 40px 48px 36px;
    background:
      radial-gradient(ellipse 50% 120% at 90% 0%, color-mix(in srgb, var(--a) 45%, transparent) 0%, transparent 70%),
      radial-gradient(ellipse 40% 100% at 60% 100%, color-mix(in srgb, var(--b) 45%, transparent) 0%, transparent 70%);
    border-bottom: 1px solid var(--line);
  }
  .crumbs { display: flex; gap: 8px; font-size: 14px; color: var(--text-3); margin-bottom: 20px; }
  .crumbs a:hover { color: #fff; }
  .crumbs [aria-current] { color: #fff; }
  h1 { margin: 0; font-size: clamp(36px, 5vw, 64px); font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .head p { margin: 16px 0 0; max-width: 720px; font-size: 18px; line-height: 1.55; color: var(--text-2); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    padding: 32px 48px 64px;
  }
  .card {
    appearance: none; font: inherit; color: inherit; text-align: left; cursor: pointer; padding: 0;
    background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
    transition: border-color .2s, transform .2s;
  }
  .card:hover { border-color: var(--accent-hi); transform: translateY(-2px); }
  .tc { position: absolute; right: 10px; bottom: 10px; z-index: 1; font-size: 12px; background: rgba(0,0,0,.6); padding: 2px 7px; border-radius: 4px; }
  .meta { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px 16px; }
  .title { font-size: 17px; font-weight: 600; }
  .sub { font-size: 14px; color: var(--text-3); }
  .empty { color: var(--text-3); }

  .reel { padding: 32px 48px 64px; }
  .reel iframe, .reel-empty {
    width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 14px; background: #000;
  }
  .reel-empty { display: grid; place-items: center; color: var(--text-3); font-size: 14px; padding: 24px; text-align: center; border: 1px dashed var(--line-2); background: var(--bg-2); }

  .viewer {
    width: min(1100px, calc(100vw - 32px)); max-height: calc(100vh - 32px);
    padding: 0; border: 1px solid var(--line-2); border-radius: 16px;
    background: var(--bg-2); color: var(--text);
  }
  .viewer::backdrop { background: rgba(5,4,14,.8); backdrop-filter: blur(6px); }
  .viewer-inner { position: relative; }
  .close {
    position: absolute; right: 12px; top: 12px; z-index: 2; width: 44px; height: 44px; border-radius: 999px;
    display: grid; place-items: center; border: 0; background: rgba(0,0,0,.55); color: #fff; cursor: pointer;
  }
  .frame { aspect-ratio: 16 / 9; }
  .frame iframe { width: 100%; height: 100%; border: 0; display: block; }
  .viewer-meta { padding: 20px 24px 24px; }
  .viewer-meta h2 { margin: 0 0 6px; font-size: 24px; letter-spacing: -0.02em; }
  .viewer-meta p { margin: 0; color: var(--text-2); }
  .viewer-meta .file { margin-top: 10px; font-size: 13px; color: var(--text-3); }

  @media (max-width: 760px) {
    .head { padding: 28px 16px; }
    .grid, .reel { padding: 20px 16px 40px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
