---
import Base from '../../layouts/Base.astro';
import Shell from '../../components/WorkspaceShell.astro';
import Thumb from '../../components/Thumb.astro';
import data from '../../data/projects.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  return data.disciplines.filter((d) => !d.archived).map((d) => ({ params: { discipline: d.slug }, props: { d } }));
}

const { d } = Astro.props;
const isReel = d.slug === 'reel';
const projects = data.projects
  .filter((p) => p.disciplines.includes(d.slug))
  .map((p, i) => {
    const eps = p.episodes ?? [];
    const embed = p.embed || eps.find((e) => e.embed)?.embed || '';
    const bits =
      d.slug === 'post' ? [p.year] : d.slug === 'colorist' ? [p.client, p.year] : [p.client, p.role, p.year];
    if (p.episodeCount) bits.push(`${p.episodeCountEstimated ? '~' : ''}${p.episodeCount} episodes`);
    else if (eps.length) bits.push(`${eps.length} episodes`);
    return { ...p, i, eps, embed, sub: bits.filter(Boolean).join(' · ') };
  });

const AWARD_ICON = '★';

// Post page groups shows under their network; other pages are one flat grid.
const groups: { name: string; items: typeof projects }[] = [];
for (const p of projects) {
  const name = d.slug === 'post' ? p.brand || '' : '';
  let g = groups.find((x) => x.name === name);
  if (!g) groups.push((g = { name, items: [] }));
  g.items.push(p);
}
---
<Base title={d.title} description={d.intro || undefined}>
  <Shell current={isReel ? 'reel' : 'work'}>
    <div class="head" style={`--base:${d.base};--a:${d.glowA};--b:${d.glowB}`}>
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/work">All Work</a><span aria-hidden="true">/</span><span aria-current="page">{d.title}</span>
      </nav>
      <h1>{d.title}</h1>
      {d.intro && <p>{d.intro}</p>}
    </div>

    {isReel ? (
      <main class="reel">
        {site.reel.embed ? (
          <iframe
            src={site.reel.embed}
            title="Demo reel"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        ) : (
          <div class="reel-empty mono">[REEL EMBED GOES HERE: set reel.embed in src/data/site.json]</div>
        )}
        {site.reel.url && (
          <a class="reel-out" href={site.reel.url} target="_blank" rel="noopener">Not loading? Open the reel in a new tab →</a>
        )}
      </main>
    ) : (
      <main class="groups">
        {groups.map((g) => (
          <section class="group" aria-label={g.name || d.title}>
            {g.name && <h2 class="group-head">{g.name} <span>{g.items.length}</span></h2>}
            <div class="grid">
              {g.items.map((p) => (
                <button class="card" type="button" data-loop-host data-open={`p-${p.i}`}>
                  <Thumb still={p.still} loop={p.loop} index={p.i} label={p.title}>
                    {p.tc && <span class="tc mono">{p.tc}</span>}
                    {p.award && <span class="award">{AWARD_ICON} Award winner</span>}
                  </Thumb>
                  <span class="meta">
                    <span class="title">{p.title}</span>
                    {d.slug === 'post' && (
                      <span class={p.views ? 'views' : 'views views--empty'}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                        {p.views ? `${p.viewsEstimated ? '~' : ''}${p.views} views` : '[VIEWS]'}
                      </span>
                    )}
                    {p.sub && <span class="sub">{p.sub}</span>}
                    {p.award && <span class="award-line">{p.award}</span>}
                  </span>
                </button>
              ))}
            </div>
          </section>
        ))}
        {projects.length === 0 && <p class="empty">Projects coming soon.</p>}
      </main>
    )}

    {!isReel && projects.map(({ i, ...p }) => (
      <dialog id={`p-${i}`} class="viewer" aria-labelledby={`p-${i}-t`}>
        <div class="v-bar">
          <span class="v-crumbs">
            <span>{site.name}</span><span aria-hidden="true">/</span><span>{d.title}</span>
            {p.brand && <><span aria-hidden="true">/</span><span>{p.brand}</span></>}
          </span>
          <button class="close" type="button" aria-label="Close" data-close>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
        <div class="v-body">
          <div class="v-media">
            {p.embed ? (
              <div class="frame">
                <iframe data-src={p.embed} title={p.title} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
              </div>
            ) : (
              <div class="v-thumb"><Thumb still={p.still} index={i} label={p.title} /></div>
            )}
            {p.eps.length > 0 && (
              <div class="v-eps">
                <h3>Featured guests</h3>
                <ul class="eps">
                  {p.eps.map((e) => (
                    <li>
                      {e.embed ? (
                        <button type="button" class="ep ep--play" data-ep={e.embed}>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5l12 7-12 7z"/></svg>
                          {e.title}
                        </button>
                      ) : (
                        <span class="ep">{e.title}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          <div class="v-info">
            <h2 id={`p-${i}-t`}>{p.title}</h2>
            <ul class="v-stats">
              {(p.brand || p.client) && <li>{p.brand || p.client}</li>}
              {d.slug === 'post' && p.views && <li class="v-strong">{p.viewsEstimated ? '~' : ''}{p.views} views</li>}
              {p.episodeCount > 0 && <li>{p.episodeCountEstimated ? '~' : ''}{p.episodeCount} episodes</li>}
              {p.year && <li>{p.year}</li>}
              {p.award && <li class="v-award">★ {p.award}</li>}
            </ul>
            {p.description && (
              <section class="v-sec">
                <h3>{d.slug === 'post' ? 'About the show' : 'About the project'}</h3>
                <p>{p.description}</p>
              </section>
            )}
            {p.contributions?.length > 0 && (
              <section class="v-sec">
                <h3>What I did</h3>
                <ul class="v-did">
                  {p.contributions.map((c) => <li class={c.startsWith('[') ? 'is-todo' : undefined}>{c}</li>)}
                </ul>
              </section>
            )}
            <p class="mono v-file">{p.file}</p>
          </div>
        </div>
      </dialog>
    ))}
  </Shell>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dlg = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
      if (!dlg) return;
      const frame = dlg.querySelector<HTMLIFrameElement>('iframe[data-src]');
      if (frame && !frame.src) frame.src = frame.dataset.src!;
      dlg.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.viewer').forEach((dlg) => {
    const close = () => {
      dlg.close();
    };
    dlg.querySelector('[data-close]')?.addEventListener('click', close);
    dlg.querySelectorAll<HTMLButtonElement>('[data-ep]').forEach((b) => {
      b.addEventListener('click', () => {
        const frame = dlg.querySelector<HTMLIFrameElement>('iframe');
        if (frame) frame.src = b.dataset.ep!;
        dlg.querySelectorAll('[data-ep]').forEach((x) => x.classList.toggle('is-on', x === b));
      });
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.addEventListener('close', () => {
      // Stop playback when the viewer closes.
      const frame = dlg.querySelector<HTMLIFrameElement>('iframe');
      if (frame && frame.src) frame.src = frame.src;
    });
  });
</script>

<style>
  .head {
    position: relative;
    padding: 40px 48px 36px;
    background:
      radial-gradient(ellipse 50% 120% at 90% 0%, color-mix(in srgb, var(--a) 45%, transparent) 0%, transparent 70%),
      radial-gradient(ellipse 40% 100% at 60% 100%, color-mix(in srgb, var(--b) 45%, transparent) 0%, transparent 70%);
    border-bottom: 1px solid var(--line);
  }
  .crumbs { display: flex; gap: 8px; font-size: 14px; color: var(--text-3); margin-bottom: 20px; }
  .crumbs a:hover { color: #fff; }
  .crumbs [aria-current] { color: #fff; }
  h1 { margin: 0; font-size: clamp(36px, 5vw, 64px); font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .head p { margin: 16px 0 0; max-width: 720px; font-size: 18px; line-height: 1.55; color: var(--text-2); }

  .groups { padding: 32px 48px 64px; display: flex; flex-direction: column; gap: 48px; }
  .group-head {
    margin: 0 0 18px; font-size: 22px; font-weight: 600; letter-spacing: -0.02em;
    display: flex; align-items: center; gap: 10px;
  }
  .group-head span {
    font-size: 13px; font-weight: 500; color: var(--text-3);
    border: 1px solid var(--line-2); border-radius: 999px; padding: 2px 10px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }
  .award {
    position: absolute; left: 10px; top: 10px; z-index: 1; font-size: 12px; font-weight: 600;
    background: rgba(0,0,0,.6); color: #ffd98a; padding: 4px 9px; border-radius: 999px;
  }
  .views {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 15px; font-weight: 600; color: #fff; font-variant-numeric: tabular-nums;
  }
  .views svg { color: var(--accent-hi); }
  .views--empty { color: var(--text-3); font-weight: 500; font-family: var(--mono); font-size: 12px; }
  .award-line { font-size: 13px; color: #ffd98a; }
  .eps { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .ep {
    display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 14px;
    border-radius: 999px; border: 1px solid var(--line-2); font: inherit; font-size: 14px; color: var(--text-2);
    background: transparent;
  }
  .ep--play { color: #fff; cursor: pointer; }
  .ep--play:hover, .ep--play.is-on { background: var(--accent); border-color: var(--accent); }
  .card {
    appearance: none; font: inherit; color: inherit; text-align: left; cursor: pointer; padding: 0;
    display: flex; flex-direction: column; justify-content: flex-start;
    background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
    transition: border-color .2s, transform .2s;
  }
  .card:hover { border-color: var(--accent-hi); transform: translateY(-2px); }
  .tc { position: absolute; right: 10px; bottom: 10px; z-index: 1; font-size: 12px; background: rgba(0,0,0,.6); padding: 2px 7px; border-radius: 4px; }
  .meta { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px 16px; }
  .title { font-size: 17px; font-weight: 600; }
  .sub { font-size: 14px; color: var(--text-3); }
  .empty { color: var(--text-3); }

  .reel { padding: 32px 48px 64px; }
  .reel iframe, .reel-empty {
    width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 14px; background: #000;
  }
  .reel-out { display: inline-block; margin-top: 16px; font-size: 14px; color: var(--text-2); text-decoration: underline; text-underline-offset: 4px; }
  .reel-empty { display: grid; place-items: center; color: var(--text-3); font-size: 14px; padding: 24px; text-align: center; border: 1px dashed var(--line-2); background: var(--bg-2); }

  .viewer {
    width: min(1180px, calc(100vw - 32px)); max-height: calc(100vh - 48px);
    padding: 0; border: 1px solid rgba(255,255,255,.14); border-radius: 16px;
    background: #0d0d10; color: var(--text); overflow: hidden;
    box-shadow: 0 40px 120px rgba(0,0,0,.7);
  }
  .viewer[open] { display: flex; flex-direction: column; animation: v-in .22s ease-out; }
  @keyframes v-in { from { opacity: 0; transform: translateY(12px) scale(.985); } }
  .viewer::backdrop { background: rgba(0,0,0,.72); backdrop-filter: blur(8px); }
  .v-bar {
    flex-shrink: 0; height: 52px; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 0 8px 0 20px; border-bottom: 1px solid var(--line);
  }
  .v-crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--text-3); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .v-crumbs span:first-child { color: #fff; font-weight: 600; }
  .close {
    width: 40px; height: 40px; border-radius: 999px; flex-shrink: 0;
    display: grid; place-items: center; border: 0; background: transparent; color: var(--text-2); cursor: pointer;
  }
  .close:hover { background: rgba(255,255,255,.08); color: #fff; }
  .v-body {
    display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    min-height: 0; overflow-y: auto;
  }
  .v-media { padding: 20px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 20px; }
  .v-thumb, .frame { border-radius: 10px; overflow: hidden; background: #000; }
  .frame { aspect-ratio: 16 / 9; }
  .frame iframe { width: 100%; height: 100%; border: 0; display: block; }
  .v-info { padding: 24px 26px 28px; display: flex; flex-direction: column; gap: 22px; }
  .v-info h2 { margin: 0; font-size: 28px; font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; }
  .v-stats { list-style: none; margin: -8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .v-stats li {
    font-size: 13px; color: var(--text-2); padding: 4px 10px; border-radius: 999px;
    border: 1px solid var(--line-2); background: rgba(255,255,255,.03);
  }
  .v-stats .v-strong { color: #fff; font-weight: 600; }
  .v-stats .v-award { color: #ffd98a; border-color: rgba(255,217,138,.35); }
  .v-sec h3, .v-eps h3 {
    margin: 0 0 10px; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--text-3);
  }
  .v-sec p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--text-2); }
  .v-did { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .v-did li { position: relative; padding-left: 20px; font-size: 15px; line-height: 1.5; color: #e6e6ea; }
  .v-did li::before {
    content: ''; position: absolute; left: 2px; top: .62em; width: 7px; height: 7px; border-radius: 2px; background: var(--accent-hi);
  }
  .v-did li.is-todo { color: var(--text-3); font-family: var(--mono); font-size: 13px; }
  .v-did li.is-todo::before { background: var(--line-2); }
  .v-file { margin: auto 0 0; padding-top: 8px; font-size: 12px; color: var(--text-3); }
  .v-eps .eps { margin: 0; }

  @media (max-width: 900px) {
    .v-body { grid-template-columns: 1fr; }
    .v-media { border-right: 0; border-bottom: 1px solid var(--line); padding: 14px; }
    .v-info { padding: 20px 18px 24px; }
    .v-info h2 { font-size: 24px; }
  }

  @media (max-width: 760px) {
    .head { padding: 28px 16px; }
    .groups, .reel { padding: 20px 16px 40px; }
    .groups { gap: 36px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
