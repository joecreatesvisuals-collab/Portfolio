---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Thumb from '../components/Thumb.astro';
import site from '../data/site.json';
import data from '../data/projects.json';

const heroCards = data.projects.filter((p) => p.hero).slice(0, 6);
const sidebar = data.disciplines;
---
<Base>
  <div class="page">
    {site.announcement.text && (
      <a class="announce" href={site.announcement.href}>{site.announcement.text} →</a>
    )}
    <Nav />

    <main class="hero">
      <div class="copy">
        <h1>{site.headline}</h1>
        <p>{site.subhead}</p>
        <div class="ctas">
          <a href="/work" class="pill pill--solid">Enter Workspace</a>
          <a href="/work/reel" class="pill pill--ghost">Watch the Reel →</a>
        </div>
      </div>

      <div class="app" aria-label="Selected work">
        <div class="rail" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8f89b0" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8f89b0" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8"/><path d="M10 20a2 2 0 0 0 4 0"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8f89b0" stroke-width="2"><path d="M12 16V4"/><path d="M7 9l5-5 5 5"/><path d="M4 20h16"/></svg>
        </div>
        <nav class="side" aria-label="Workspace">
          <div class="side-head">Workspace</div>
          <a href="/work" class="side-item is-active">All Work</a>
          {sidebar.map((d) => <a href={`/work/${d.slug}`} class="side-item">{d.title.replace(' Production', '')}</a>)}
        </nav>
        <div class="main">
          <div class="crumbs"><strong>{site.name}</strong><span>/</span><span>All Work</span><span>/</span><span class="on">Selects</span></div>
          <div class="toolbar" aria-hidden="true"><span>Appearance</span><span>Fields</span><span>Sorted by Date</span></div>
          <div class="grid">
            {heroCards.map((p, i) => (
              <a class="card" href={`/work/${p.disciplines[0]}`} data-loop-host>
                <Thumb still={p.still} loop={p.loop} index={i} label={p.title}>
                  {p.tc && <span class="tc mono">{p.tc}</span>}
                </Thumb>
                <div class="meta">
                  <div class="file mono">{p.file}</div>
                  <div class="client">{p.client}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </main>

    <section class="clients" aria-label="Clients">
      <div class="clients-label">WORK FOR AND WITH</div>
      <div class="marquee">
        <div class="track">
          {[0, 1].map((dup) => (
            <ul aria-hidden={dup === 1 ? 'true' : undefined}>
              {site.clients.map((c) => (
                <li>{c.logo ? <img src={c.logo} alt={c.name} /> : c.name}</li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    overflow-x: clip;
    background:
      radial-gradient(ellipse 900px 600px at 72% 18%, #3a2a78 0%, rgba(58,42,120,0) 70%),
      radial-gradient(ellipse 700px 500px at 20% 70%, #2a1d5c 0%, rgba(42,29,92,0) 70%),
      var(--bg);
  }
  .announce {
    display: block;
    padding: 12px var(--gutter);
    background: var(--accent);
    text-align: center;
    font-size: 15px;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .announce:hover { color: #fff; background: #6a5cf0; }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 600px) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    padding: 72px 0 96px var(--gutter);
  }
  .copy { display: flex; flex-direction: column; gap: 32px; }
  h1 {
    margin: 0;
    font-size: clamp(52px, 7.2vw, 104px);
    line-height: 0.98;
    font-weight: 600;
    letter-spacing: -0.045em;
  }
  .copy p { margin: 0; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.5; color: var(--text-2); }
  .ctas { display: flex; gap: 16px; flex-wrap: wrap; }

  /* Fake review app */
  .app {
    width: 820px;
    max-width: none;
    height: 600px;
    display: flex;
    background: var(--bg-2);
    border: 1px solid rgba(255,255,255,.1);
    border-right: 0;
    border-radius: 14px 0 0 14px;
    box-shadow: 0 40px 120px rgba(0,0,0,.55);
    overflow: hidden;
  }
  .rail { width: 56px; flex-shrink: 0; background: #0a0916; display: flex; flex-direction: column; align-items: center; gap: 22px; padding-top: 20px; }
  .side { width: 180px; flex-shrink: 0; border-right: 1px solid var(--line); padding: 18px 12px; display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
  .side-head { font-weight: 600; font-size: 12px; color: #8f89b0; padding: 0 8px 8px; }
  .side-item { padding: 7px 8px; border-radius: 6px; }
  .side-item:hover, .side-item.is-active { background: rgba(255,255,255,.08); color: #fff; }
  .main { flex-grow: 1; display: flex; flex-direction: column; min-width: 0; }
  .crumbs { height: 48px; flex-shrink: 0; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 8px; padding: 0 18px; font-size: 13px; color: #8f89b0; }
  .crumbs strong, .crumbs .on { color: #fff; }
  .toolbar { height: 44px; flex-shrink: 0; display: flex; align-items: center; gap: 18px; padding: 0 18px; font-size: 13px; color: var(--text-2); }
  .grid { padding: 4px 18px 18px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; transition: border-color .2s; }
  .card:hover { border-color: var(--accent-hi); color: #fff; }
  .tc { position: absolute; right: 8px; bottom: 8px; z-index: 1; font-size: 11px; background: rgba(0,0,0,.6); padding: 2px 6px; border-radius: 4px; }
  .meta { padding: 10px 12px; display: flex; flex-direction: column; gap: 4px; }
  .file { font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .client { font-size: 11px; color: var(--text-3); }

  /* Clients */
  .clients { padding: 24px 0 96px; display: flex; flex-direction: column; align-items: center; gap: 32px; }
  .clients-label { font-size: 14px; color: var(--text-3); letter-spacing: .08em; }
  .marquee {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track { display: flex; width: max-content; animation: scroll 40s linear infinite; }
  .track ul { display: flex; gap: 64px; margin: 0; padding: 0 32px; list-style: none; }
  .track li { font-size: 30px; font-weight: 600; color: #a8a2cc; white-space: nowrap; }
  .track img { height: 36px; width: auto; opacity: .75; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  @media (max-width: 1100px) {
    .hero { grid-template-columns: 1fr; padding-right: var(--gutter); gap: 56px; }
    .app { width: 100%; height: auto; border-right: 1px solid rgba(255,255,255,.1); border-radius: 14px; }
    .rail { display: none; }
  }
  @media (max-width: 700px) {
    .hero { padding-top: 40px; }
    .side, .toolbar { display: none; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .track li { font-size: 22px; }
  }
</style>
